{
	"servers": {
		"edinetdb": {
			"url": "https://edinetdb.jp/mcp",
			"type": "http",
			"headers": {
				"Authorization": "Bearer ${input:edinetdb_api_key}"
			}
		}
	},
	"inputs": [
		{
			"id": "edinetdb_api_key",
			"type": "promptString",
			"description": "EDINET DB API Key",
			"password": true
		}
	]
}